{% extends 'base.html.twig' %}

{% block title %}Hello ProfileController!{% endblock %}

    {% block main %}
        <section class="p-6 bg-gray-100 text-gray-900">
            {{ form_start(form, {'form_attr':{'class':'container flex flex-col mx-auto space-y-12'}}) }}
            {#        <form novalidate="" action="" class="container flex flex-col mx-auto space-y-12"> #}
                <fieldset class="grid grid-cols-4 gap-6 p-6 rounded-md shadow-sm bg-gray-50">
                    <div class="space-y-2 col-span-full lg:col-span-1">
                        <p class="font-medium">Profile Information</p>
                        <p class="text-xs">Who are you?</p>
                    </div>
                    <div class="grid grid-cols-6 gap-4 col-span-full lg:col-span-3">
                        <div class="col-span-full">
                            <label for="username" class="text-sm">Username</label>
                            <input id="username" type="text" value={{ app.user.getUsername }} disabled class="w-full rounded-md focus:ring focus:ring-opacity-75 text-gray-900 focus:ring-fuchsia-600 border-gray-300">
                        </div>
                        <div class="col-span-full sm:col-span-3">
                            {{ form_label(form.city,'City', { 'label_attr': { 'class':'text-sm' }} ) }}
                            {{ form_widget(form.city,{'attr':{'class':'w-full rounded-md focus:ring focus:ring-opacity-75 text-gray-900 focus:ring-fuchsia-600 border-gray-300','placeholder':'City'}}) }}
                        </div>
                        <div class="col-span-full sm:col-span-3">
                            {{ form_label(form.location,'Postal Code', { 'label_attr': { 'class':'text-sm' }} ) }}
                            {{ form_widget(form.location,{'attr':{'class':'w-full rounded-md focus:ring focus:ring-opacity-75 text-gray-900 focus:ring-fuchsia-600 border-gray-300','placeholder':'Postal Code'}}) }}
                        </div>
                        <div class="col-span-full sm:col-span-2">
                            {{ form_label(form.birthdate,'Birth Date', { 'label_attr': { 'class':'text-sm' }} ) }}
                            {{ form_widget(form.birthdate,{'attr':{'class':'w-full rounded-md focus:ring focus:ring-opacity-75 text-gray-900 focus:ring-fuchsia-600 border-gray-300','placeholder':'Birthdate'}}) }}
                        </div>
                        <div class="col-span-full sm:col-span-2">
                            {{ form_label(form.status,'Status', { 'label_attr': { 'class':'text-sm' }} ) }}
                            {{ form_widget(form.status,{'attr':{'class':'w-full rounded-md focus:ring focus:ring-opacity-75 text-gray-900 focus:ring-fuchsia-600 border-gray-300','placeholder':'Status'}}) }}
                        </div>
                        <div class="col-span-full">
                            {{ form_label(form.bio,'Bio', { 'label_attr': { 'class':'text-sm' }} ) }}
                            {{ form_widget(form.bio,{'attr':{'class':'w-full rounded-md focus:ring focus:ring-opacity-75 text-gray-900 focus:ring-fuchsia-600 border-gray-300','placeholder':'Bio'}}) }}
                        </div>
                    </div>
                </fieldset>
                <fieldset class="grid grid-cols-4 gap-6 p-6 rounded-md shadow-sm bg-gray-50">
                    <div class="space-y-2 col-span-full lg:col-span-1">
                        <p class="font-medium">Images</p>
                        <p class="text-xs">Share your vibe</p>
                    </div>
                    <div class="grid grid-cols-6 gap-4 col-span-full lg:col-span-3">
                        <div class="col-span-full sm:col-span-3">
                            <label for="username" class="text-sm">Username</label>
                            <input id="username" type="text" placeholder="Username" class="w-full rounded-md focus:ring focus:ring-opacity-75 text-gray-900 focus:ring-fuchsia-600 border-gray-300">
                        </div>
                        <div class="col-span-full sm:col-span-3">
                            <label for="website" class="text-sm">Website</label>
                            <input id="website" type="text" placeholder="https://" class="w-full rounded-md focus:ring focus:ring-opacity-75 text-gray-900 focus:ring-fuchsia-600 border-gray-300">
                        </div>
                        <div class="col-span-full">
                            <label for="bio" class="text-sm">Bio</label>
                            <textarea id="bio" placeholder="" class="w-full rounded-md focus:ring focus:ring-opacity-75 text-gray-900 focus:ring-fuchsia-600 border-gray-300"></textarea>
                        </div>
                        <div class="col-span-full">
                            <label for="bio" class="text-sm">Photo</label>
                            <div class="flex items-center space-x-2">
                                <img src="https://source.unsplash.com/30x30/?random" alt="" class="w-10 h-10 bg-gray-500 rounded-full bg-gray-300">
                                <button type="button" class="px-4 py-2 border rounded-md border-gray-800">Change</button>
                            </div>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="grid grid-cols-4 gap-6 p-6 rounded-md shadow-sm bg-gray-50">
                    <div class="space-y-2 col-span-full lg:col-span-1">
                        <p class="font-medium">Interests</p>
                        <p class="text-xs">What do you like?</p>
                    </div>
                    <div class="grid grid-cols-6 gap-4 col-span-full lg:col-span-3">
                    </div>
                </fieldset>
                <fieldset class="grid grid-cols-4 gap-6 p-6 rounded-md shadow-sm bg-gray-50">
                    {{ form_widget(form.save, {'attr':{'class':'px-8 py-3 font-semibold rounded-full bg-gray-800 text-gray-100'}}) }}
                </fieldset>
                {{ form_end(form) }}
        </section>
    {% endblock %}
